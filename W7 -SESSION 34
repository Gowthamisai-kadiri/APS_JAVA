class Solution {
public:
    
    void dfs(int room, vector<vector<int>>& rooms, vector<bool>& visited) {
        
        visited[room] = true;
        
        for (int key : rooms[room]) {
            if (!visited[key]) {
                dfs(key, rooms, visited);
            }
        }
    }
    
    bool canVisitAllRooms(vector<vector<int>>& rooms) {
        
        int n = rooms.size();
        vector<bool> visited(n, false);
        
        // Room 0 is unlocked initially
        dfs(0, rooms, visited);
        
        // Check whether all rooms are visited
        for (int i = 0; i < n; i++) {
            if (!visited[i])
                return false;
        }
        
        return true;
    }
};

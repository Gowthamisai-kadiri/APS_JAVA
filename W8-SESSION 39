class Solution {
public:
    
    void dfs(string email,
             unordered_map<string, vector<string>>& graph,
             unordered_set<string>& visited,
             vector<string>& emails) {
        
        visited.insert(email);
        emails.push_back(email);
        
        for (string next : graph[email]) {
            if (!visited.count(next)) {
                dfs(next, graph, visited, emails);
            }
        }
    }
    
    vector<vector<string>> accountsMerge(vector<vector<string>>& accounts) {
        
        // email -> person name
        unordered_map<string, string> emailToName;
        
        // email graph
        unordered_map<string, vector<string>> graph;
        
        // Build graph
        for (auto& account : accounts) {
            
            string name = account[0];
            string firstEmail = account[1];
            
            emailToName[firstEmail] = name;
            
            for (int i = 2; i < account.size(); i++) {
                
                string email = account[i];
                
                emailToName[email] = name;
                
                // Connect emails in same account
                graph[firstEmail].push_back(email);
                graph[email].push_back(firstEmail);
            }
        }
        
        unordered_set<string> visited;
        vector<vector<string>> answer;
        
        // DFS for every unvisited email
        for (auto& [email, name] : emailToName) {
            
            if (visited.count(email))
                continue;
            
            vector<string> emails;
            
            dfs(email, graph, visited, emails);
            
            // Sort emails
            sort(emails.begin(), emails.end());
            
            // Add name at beginning
            vector<string> account;
            account.push_back(name);
            
            for (string e : emails) {
                account.push_back(e);
            }
            
            answer.push_back(account);
        }
        
        return answer;
    }
};

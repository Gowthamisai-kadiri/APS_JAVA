class Solution {
public:
    
    int dfs(int r, int c, vector<vector<int>>& grid) {
        
        int m = grid.size();
        int n = grid[0].size();
        
        // Out of bounds or water
        if (r < 0 || r >= m || c < 0 || c >= n || grid[r][c] == 0)
            return 0;
        
        // Mark as visited
        grid[r][c] = 0;
        
        // Count current cell + 4 directions
        return 1
            + dfs(r + 1, c, grid)
            + dfs(r - 1, c, grid)
            + dfs(r, c + 1, grid)
            + dfs(r, c - 1, grid);
    }
    
    int maxAreaOfIsland(vector<vector<int>>& grid) {
        
        int m = grid.size();
        int n = grid[0].size();
        
        int maxArea = 0;
        
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                
                if (grid[i][j] == 1) {
                    int area = dfs(i, j, grid);
                    maxArea = max(maxArea, area);
                }
            }
        }
        
        return maxArea;
    }
};
